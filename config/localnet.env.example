ANCHOR_PROVIDER_URL=http://127.0.0.1:8899
SOLID_RPC_URL=http://127.0.0.1:8899
SOLID_ALLOW_NON_LOCALNET=0
SOLID_KEYPAIR_PATH=$HOME/.config/solana/id.json
SOLANA_KEYPAIR_PATH=$HOME/.config/solana/id.json
ANCHOR_WALLET=$HOME/.config/solana/id.json
SOLID_VOTING_PERIOD_SECONDS=120
SOLID_SCHEMA_NAME=basic_identity_v2
