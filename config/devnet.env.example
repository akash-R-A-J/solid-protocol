ANCHOR_PROVIDER_URL=https://api.devnet.solana.com
SOLID_RPC_URL=https://api.devnet.solana.com
SOLID_ALLOW_NON_LOCALNET=1
SOLID_KEYPAIR_PATH=$HOME/.config/solana/solid-devnet-admin.json
SOLANA_KEYPAIR_PATH=$HOME/.config/solana/solid-devnet-admin.json
ANCHOR_WALLET=$HOME/.config/solana/solid-devnet-admin.json
SOLID_VOTING_PERIOD_SECONDS=120
SOLID_SCHEMA_NAME=basic_identity_v2
SOLID_SCHEMA_VERSION=2
SOLID_SCHEMA_CATEGORY=Identity
SOLID_SCHEMA_FIELDS=age,country_code,region,id_type,verification_level,issued_date,nationality,_reserved
SOLID_SCHEMA_TREE_DEPTH=20
