{
  "name": "@solid-protocol/holder",
  "version": "0.2.0",
  "description": "Proof generation SDK for credential holders. Builds Groth16 witnesses, fetches Merkle proofs from an SPL Account-Compression adapter, and returns Solana-formatted Groth16 proofs.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@solid-protocol/core": "0.1.0",
    "@solid-protocol/light": "0.2.0",
    "@solana/web3.js": "^1.95.0",
    "snarkjs": "^0.7.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
