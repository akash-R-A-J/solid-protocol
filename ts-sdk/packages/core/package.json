{
  "name": "@solid-protocol/core",
  "version": "0.1.0",
  "description": "Core WASM bindings and cryptographic primitives for SolID Protocol.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm",
    "wasm-web"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "solana",
    "wasm",
    "poseidon",
    "babyjubjub",
    "zero-knowledge"
  ]
}
