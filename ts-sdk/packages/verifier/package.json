{
  "name": "@solid-protocol/verifier",
  "version": "0.2.0",
  "description": "Devnet alpha verifier SDK for private Solana eligibility checks with SolID Protocol.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./proof-buffer": {
      "types": "./dist/proof-buffer.d.ts",
      "import": "./dist/proof-buffer.js",
      "default": "./dist/proof-buffer.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run && npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@solid-protocol/core": "0.1.0",
    "@solana/web3.js": "^1.95.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "solana",
    "verifier",
    "zero-knowledge",
    "eligibility",
    "privacy"
  ],
  "license": "MIT"
}
