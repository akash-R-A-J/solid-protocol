{
  "name": "@solid-protocol/sdk",
  "version": "0.1.0",
  "description": "Unified TypeScript SDK for private Solana eligibility verification with SolID Protocol.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./indexer": {
      "types": "./dist/indexer.d.ts",
      "import": "./dist/indexer.js",
      "default": "./dist/indexer.js"
    },
    "./credential-requests": {
      "types": "./dist/credential-requests.d.ts",
      "import": "./dist/credential-requests.js",
      "default": "./dist/credential-requests.js"
    },
    "./credential-integrity": {
      "types": "./dist/credential-integrity.d.ts",
      "import": "./dist/credential-integrity.js",
      "default": "./dist/credential-integrity.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@solid-protocol/core": "0.1.0",
    "@solid-protocol/holder": "0.1.0",
    "@solid-protocol/issuer": "0.1.0",
    "@solid-protocol/light": "0.1.0",
    "@solid-protocol/verifier": "0.1.0",
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/web3.js": "^1.95.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "solana",
    "zk",
    "zero-knowledge",
    "credentials",
    "eligibility",
    "privacy"
  ],
  "license": "MIT"
}
