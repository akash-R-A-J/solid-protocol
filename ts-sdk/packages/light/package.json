{
  "name": "@solid-protocol/light",
  "version": "0.2.0",
  "description": "SPL Account Compression adapter and Merkle proof utilities for SolID Protocol.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build",
    "clean": "rm -rf dist",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "@solana/spl-account-compression": "^0.2.1",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "typescript": "^5.3.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "solana",
    "spl-account-compression",
    "merkle-tree",
    "credentials",
    "indexer"
  ]
}
