{
  "name": "@solid-protocol/issuer",
  "version": "0.2.0",
  "description": "Credential issuance SDK for SolID Protocol issuers.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "@solid-protocol/core": "file:../../../../../../../../tmp/solid-sdk-packs/solid-protocol-core-0.1.0.tgz",
    "@solid-protocol/light": "0.2.0",
    "bn.js": "^5.2.1",
    "buffer": "^6.0.3",
    "snarkjs": "^0.7.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "typescript": "^5.3.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "solana",
    "credentials",
    "issuer",
    "zero-knowledge",
    "privacy"
  ]
}
