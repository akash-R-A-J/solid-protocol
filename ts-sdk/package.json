{
  "name": "@solid-protocol/sdk",
  "version": "0.3.0",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:turbo": "turbo run build",
    "test": "npm run test --workspaces --if-present",
    "lint": "turbo run lint",
    "pack:check": "npm pack --workspaces --dry-run"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
