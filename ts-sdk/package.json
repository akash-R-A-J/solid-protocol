{
  "name": "solid-protocol-ts-sdk-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Private workspace for the SolID Protocol TypeScript SDK packages",
  "packageManager": "npm@10.0.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "tsc -b --pretty false",
    "build:workspaces": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b --pretty false",
    "lint": "npm run typecheck",
    "pack:check": "npm pack --workspaces --dry-run"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
