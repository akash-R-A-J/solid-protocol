PORT=8787
HOST=127.0.0.1
SOLID_MANIFEST_PATH=../deployments/devnet.json
SOLID_INDEXER_STORE_PATH=../.solid-indexer/state.json
SOLID_RPC_URL=https://api.devnet.solana.com
SOLID_INDEXER_WRITE_TOKEN=change-me

# Enables service-side SchemaTreeBinding/GlobalStateBinding updates before
# holder Merkle proofs are returned. Leave unset to fall back to the manifest
# deployer keypair path, or set SOLID_AUTO_ROOT_SYNC=0 to disable.
SOLID_ROOT_SYNC_KEYPAIR_PATH=~/.config/solana/solid-devnet-admin.json
