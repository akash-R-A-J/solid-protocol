# Flake-managed project-local toolchain cache (Solana CLI, Anchor,
# circom, snarkjs, wasm-pack).  Repopulated by scripts/bootstrap.sh.
.toolchain/

# Nix build outputs
result
result-*

# Tooling worktrees
tools/solid-prover/target

# solana-test-validator runtime ledger (populated by `solana-test-validator`).
# Runtime-only; regenerated on every --reset.  Never commit.
test-ledger/

# SolID Research & Audit (Local Only)
# docs/SOLID_INFRA_MANIFESTO.md
# docs/SOLID_SECURITY_AUDIT.md
# docs/SOLID_COMPREHENSIVE_REVIEW.md

# IMPORTANT: Cargo.lock IS checked in.
# The repo pins Cargo.lock at format v3 so anchor-cli 0.30.1 (which bundles a
# pre-1.78 cargo in platform-tools) can parse it.  Regenerate with
# `nix develop --command cargo generate-lockfile` if you need to refresh deps.

# SOLID-SEC-020: local E2E state files contain plaintext BJJ / Solana keypairs.
# They must never be committed. scripts/hooks/pre-commit-no-secrets.sh is the
# defense-in-depth gate; these patterns are the first line.
scripts/e2e_state.json
scripts/e2e_state.*.json
scripts/.secrets/
~/.solid-protocol/

# Program-deploy keypairs.
#
# `keys/localnet/` IS tracked — those keypairs back the canonical
# declare_id! values that Anchor.toml, every program crate, and
# deployments/devnet.json all agree on (CI: scripts/check_program_ids.py).
# Without them, `anchor build` silently regenerates fresh IDs on every
# clean checkout and breaks the whole owner-check / issuer-tree-binding
# invariant. They are localnet/devnet test material with no economic
# value; rotating them is harmless. See keys/localnet/README.md for the
# rationale and the devnet-rollout caveat.
#
# Anything else under `keys/` (devnet-rotated sets, mainnet upgrade
# authority, ad-hoc operator keys) MUST stay untracked. The patterns
# below allow only `keys/localnet/` and ignore everything else.
keys/*
!keys/localnet/
!keys/localnet/**

# Trusted-setup ceremony artefacts. .ptau files are large (>100 MB) and
# deterministic from snarkjs; regenerate via circuits/scripts/setup.js.
# circuits/build/ + circuits/ptau/ are already ignored above.
circuits/trusted_setup/

# Toolchain bootstrap probe (.toolchain-probe) and ad-hoc scratch (.scratch).
# .toolchain-probe caches a multi-hundred-MB Solana CLI tarball used by
# scripts/bootstrap.sh on first run; .scratch is for transient experiments.
.toolchain-probe/
.scratch/

# TypeScript incremental build cache. Per-package, regenerated by tsc.
**/tsconfig.tsbuildinfo

# Claude Code project-local settings + scheduled-task locks.  These
# encode per-developer permission grants and runtime state that should
# not flow upstream.
.claude/

# Internal docs — not shipped to GitHub.
