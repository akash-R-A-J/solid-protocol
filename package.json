{
  "name": "solid-protocol-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "E2E scripts and deployment management for SolID Protocol",
  "scripts": {
    "build:idl": "node scripts/build_idls.mjs",
    "init-onchain": "tsx scripts/initialize.ts",
    "backfill-issuer-tree": "tsx scripts/backfill_issuer_tree.ts",
    "bootstrap-schema-tree": "tsx scripts/bootstrap_schema_tree.ts",
    "bootstrap-issuer": "tsx scripts/bootstrap_issuer.ts",
    "issue": "tsx scripts/issue.ts",
    "prove": "tsx scripts/prove.ts",
    "e2e": "npm run build:idl && npm run init-onchain && npm run backfill-issuer-tree && npm run bootstrap-schema-tree && npm run bootstrap-issuer && npm run issue && npm run prove",
    "check-vectors": "tsx tests/vectors/check_vectors.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "@solana/spl-token": "^0.4.6",
    "@coral-xyz/anchor": "^0.30.1",
    "snarkjs": "^0.7.4",
    "ffjavascript": "^0.2.63",
    "@solid-protocol/core": "file:./ts-sdk/packages/core",
    "@solid-protocol/issuer": "file:./ts-sdk/packages/issuer",
    "@solid-protocol/holder": "file:./ts-sdk/packages/holder",
    "@solid-protocol/verifier": "file:./ts-sdk/packages/verifier",
    "@solid-protocol/light": "file:./ts-sdk/packages/light",
    "@solid-protocol/sdk": "file:./ts-sdk/packages/sdk"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "@types/node": "^20.11.0"
  }
}
